# ==========================================
# 环境变量与机密配置 (Environment & Secrets)
# ==========================================
.env
.env*.local
!.env.example

# ==========================================
# 前端 Next.js / Node.js
# ==========================================
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 包管理器日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 后端 Python / FastAPI
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 虚拟环境 (Virtual Environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 测试与覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ==========================================
# 数据与临时存储 (保留目录结构，忽略生成文件)
# ==========================================
/data/input/*
!/data/input/.gitkeep

/data/output/*
!/data/output/.gitkeep

/data/temp/*
!/data/temp/.gitkeep

/data/logs/*
!/data/logs/.gitkeep

# 通用日志与临时文件
*.log
*.tmp
*.temp

# ==========================================
# 操作系统与 IDE 配置
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE / 编辑器
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
